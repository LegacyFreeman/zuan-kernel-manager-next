<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/zw_root" android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical" android:padding="10dp" android:background="@drawable/zw_bg">
    <LinearLayout android:id="@+id/zw_header" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="horizontal" android:gravity="center_vertical" android:layout_marginBottom="4dp">
        <ImageView android:layout_width="18dp" android:layout_height="18dp" android:src="@drawable/zw_ic_speed"
            android:tint="@color/zw_accent" android:contentDescription="@null" />
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="8dp"
            android:text="ZKM Performance" android:textColor="@color/zw_text" android:textSize="14sp" android:textStyle="bold" />
        <TextView android:id="@+id/zw_perf_status" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:layout_marginStart="8dp" android:textColor="@color/zw_text_dim" android:textSize="11sp"
            android:maxLines="1" android:ellipsize="end" />
    </LinearLayout>
    <LinearLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1"
        android:orientation="horizontal">
        <LinearLayout android:id="@+id/zw_mode_balance" android:layout_width="0dp" android:layout_height="match_parent"
            android:layout_weight="1" android:layout_margin="2dp" android:orientation="vertical"
            android:gravity="center" android:padding="4dp" android:background="@drawable/zw_chip">
            <ImageView android:id="@+id/zw_mode_balance_icon" android:layout_width="20dp" android:layout_height="20dp"
                android:src="@drawable/zw_ic_tune" android:tint="@color/zw_text" android:contentDescription="@null" />
            <TextView android:id="@+id/zw_mode_balance_label" android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:layout_marginTop="4dp" android:text="Balance" android:textColor="@color/zw_text"
                android:textSize="11sp" android:maxLines="1" android:ellipsize="end" />
        </LinearLayout>
        <LinearLayout android:id="@+id/zw_mode_dynamic" android:layout_width="0dp" android:layout_height="match_parent"
            android:layout_weight="1" android:layout_margin="2dp" android:orientation="vertical"
            android:gravity="center" android:padding="4dp" android:background="@drawable/zw_chip">
            <ImageView android:id="@+id/zw_mode_dynamic_icon" android:layout_width="20dp" android:layout_height="20dp"
                android:src="@drawable/zw_ic_bolt" android:tint="@color/zw_text" android:contentDescription="@null" />
            <TextView android:id="@+id/zw_mode_dynamic_label" android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:layout_marginTop="4dp" android:text="Dynamic" android:textColor="@color/zw_text"
                android:textSize="11sp" android:maxLines="1" android:ellipsize="end" />
        </LinearLayout>
        <LinearLayout android:id="@+id/zw_mode_perf" android:layout_width="0dp" android:layout_height="match_parent"
            android:layout_weight="1" android:layout_margin="2dp" android:orientation="vertical"
            android:gravity="center" android:padding="4dp" android:background="@drawable/zw_chip">
            <ImageView android:id="@+id/zw_mode_perf_icon" android:layout_width="20dp" android:layout_height="20dp"
                android:src="@drawable/zw_ic_speed" android:tint="@color/zw_text" android:contentDescription="@null" />
            <TextView android:id="@+id/zw_mode_perf_label" android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:layout_marginTop="4dp" android:text="Performance" android:textColor="@color/zw_text"
                android:textSize="11sp" android:maxLines="1" android:ellipsize="end" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
