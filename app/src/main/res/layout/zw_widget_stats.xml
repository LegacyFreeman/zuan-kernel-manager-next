<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/zw_root" android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical" android:padding="10dp" android:background="@drawable/zw_bg">
    <LinearLayout android:id="@+id/zw_header" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="horizontal" android:gravity="center_vertical" android:layout_marginBottom="4dp">
        <ImageView android:layout_width="18dp" android:layout_height="18dp" android:src="@drawable/zw_ic_memory"
            android:tint="@color/zw_accent" android:contentDescription="@null" />
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="8dp"
            android:text="Live Stats" android:textColor="@color/zw_text" android:textSize="14sp" android:textStyle="bold" />
        <TextView android:id="@+id/zw_stats_status" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:layout_marginStart="8dp" android:textColor="@color/zw_text_dim" android:textSize="11sp"
            android:maxLines="1" android:ellipsize="end" />
    </LinearLayout>
    <LinearLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1"
        android:orientation="horizontal">
        <LinearLayout android:id="@+id/zw_s0" android:layout_width="0dp" android:layout_height="match_parent"
            android:layout_weight="1" android:layout_margin="2dp" android:orientation="vertical"
            android:gravity="center_vertical" android:padding="8dp" android:background="@drawable/zw_card">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="horizontal" android:gravity="center_vertical">
                <ImageView android:layout_width="14dp" android:layout_height="14dp" android:src="@drawable/zw_ic_battery"
                    android:tint="@color/zw_text_dim" android:contentDescription="@null" />
                <TextView android:id="@+id/zw_s0_label" android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:layout_marginStart="5dp" android:textColor="@color/zw_text_dim" android:textSize="10sp" />
            </LinearLayout>
            <TextView android:id="@+id/zw_s0_value" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="2dp" android:textColor="@color/zw_text" android:textSize="18sp"
                android:textStyle="bold" android:maxLines="1" android:ellipsize="end" />
            <ProgressBar android:id="@+id/zw_s0_bar" style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="match_parent" android:layout_height="6dp" android:layout_marginTop="6dp"
                android:max="100" android:progressDrawable="@drawable/zw_bar" />
        </LinearLayout>
        <LinearLayout android:id="@+id/zw_s1" android:layout_width="0dp" android:layout_height="match_parent"
            android:layout_weight="1" android:layout_margin="2dp" android:orientation="vertical"
            android:gravity="center_vertical" android:padding="8dp" android:background="@drawable/zw_card">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="horizontal" android:gravity="center_vertical">
                <ImageView android:layout_width="14dp" android:layout_height="14dp" android:src="@drawable/zw_ic_bolt"
                    android:tint="@color/zw_text_dim" android:contentDescription="@null" />
                <TextView android:id="@+id/zw_s1_label" android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:layout_marginStart="5dp" android:textColor="@color/zw_text_dim" android:textSize="10sp" />
            </LinearLayout>
            <TextView android:id="@+id/zw_s1_value" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="2dp" android:textColor="@color/zw_text" android:textSize="18sp"
                android:textStyle="bold" android:maxLines="1" android:ellipsize="end" />
            <ProgressBar android:id="@+id/zw_s1_bar" style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="match_parent" android:layout_height="6dp" android:layout_marginTop="6dp"
                android:max="100" android:progressDrawable="@drawable/zw_bar" />
        </LinearLayout>
    </LinearLayout>
    <LinearLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1"
        android:orientation="horizontal">
        <LinearLayout android:id="@+id/zw_s2" android:layout_width="0dp" android:layout_height="match_parent"
            android:layout_weight="1" android:layout_margin="2dp" android:orientation="vertical"
            android:gravity="center_vertical" android:padding="8dp" android:background="@drawable/zw_card">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="horizontal" android:gravity="center_vertical">
                <ImageView android:layout_width="14dp" android:layout_height="14dp" android:src="@drawable/zw_ic_memory"
                    android:tint="@color/zw_text_dim" android:contentDescription="@null" />
                <TextView android:id="@+id/zw_s2_label" android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:layout_marginStart="5dp" android:textColor="@color/zw_text_dim" android:textSize="10sp" />
            </LinearLayout>
            <TextView android:id="@+id/zw_s2_value" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="2dp" android:textColor="@color/zw_text" android:textSize="18sp"
                android:textStyle="bold" android:maxLines="1" android:ellipsize="end" />
            <ProgressBar android:id="@+id/zw_s2_bar" style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="match_parent" android:layout_height="6dp" android:layout_marginTop="6dp"
                android:max="100" android:progressDrawable="@drawable/zw_bar" />
        </LinearLayout>
        <LinearLayout android:id="@+id/zw_s3" android:layout_width="0dp" android:layout_height="match_parent"
            android:layout_weight="1" android:layout_margin="2dp" android:orientation="vertical"
            android:gravity="center_vertical" android:padding="8dp" android:background="@drawable/zw_card">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="horizontal" android:gravity="center_vertical">
                <ImageView android:layout_width="14dp" android:layout_height="14dp" android:src="@drawable/zw_ic_thermo"
                    android:tint="@color/zw_text_dim" android:contentDescription="@null" />
                <TextView android:id="@+id/zw_s3_label" android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:layout_marginStart="5dp" android:textColor="@color/zw_text_dim" android:textSize="10sp" />
            </LinearLayout>
            <TextView android:id="@+id/zw_s3_value" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="2dp" android:textColor="@color/zw_text" android:textSize="18sp"
                android:textStyle="bold" android:maxLines="1" android:ellipsize="end" />
            <ProgressBar android:id="@+id/zw_s3_bar" style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="match_parent" android:layout_height="6dp" android:layout_marginTop="6dp"
                android:max="100" android:progressDrawable="@drawable/zw_bar" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
